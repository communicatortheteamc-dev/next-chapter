# Omit DATABASE_URL to use isolated local demo storage in .data/. Never use demo storage in production.
ALLOW_DEMO=false
DATABASE_URL=
NEXT_PUBLIC_BRAND_NAME="Next chapter"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Local demo only; minimum 12 characters. Sign in with admin@example.com.
DEMO_ADMIN_PASSWORD=
# Seed a real database owner; password minimum 12 characters
OWNER_EMAIL=
OWNER_PASSWORD=
# Live adapters: payments remain disabled until both keys and webhook secret exist
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
